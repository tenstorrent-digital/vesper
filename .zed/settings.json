// Folder-specific settings
//
// For a full list of overridable settings, and general information
// on folder-specific settings, documentation:
// https://zed.dev/docs/configuring-zed#settings-files
{
  // Zed format on save is not "off" by default
  //
  // Add "format_on_save": "on" to your global Zed settings to
  // enable it:
  // ~/.config/zed/settings.json
  // cmd-,

  "languages": {
    "CSS": {
      // use both tailwind LSP and css LSP
      "language_servers": [
        "tailwindcss-language-server",
        "vscode-css-language-server"
      ]
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    }
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cn", "clsx", "tw"],
        "lint": {
          // don't suggest canonical classes since
          // it flags our custom spacing utilities
          // eg. w-* (in px)
          "suggestCanonicalClasses": "ignore"
        }
      }
    },
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            // ignore @_ rules from tailwind that conflict
            // with css spec
            "unknownAtRules": "ignore"
          }
        }
      }
    },
    "mdx-analyzer": {
      "initialization_options": {
        // enable typescript support for Zed MDX
        // https://github.com/srazzak/zed-mdx#typescript-configuration
        // note: Zed MDX is not a built-in ext - search 'mdx' in
        // zed's extensions panel to install
        "typescript": {
          "enabled": true
        }
      }
    }
  },

  "file_scan_exclusions": [
    // defaults - specifying any exclusions overrides the
    // default exclusions so we add them back here
    // see: https://zed.dev/docs/reference/all-settings#file-scan-exclusions
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",

    // also exclude:

    // node_modules
    "**/node_modules/**",

    // exclude contents of agent skills
    ".agents/skills/**/scripts/**",
    ".agents/skills/**/references/**",
    ".agents/skills/**/rules/**",

    // all files in `.claude` (symlinks to .agents)
    ".claude/**"
  ],
  "read_only_files": ["yarn.lock", "skills-lock.json"]
}
