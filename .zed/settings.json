{
  // for oxlint and oxfmt support in zed you will need
  // download this extension:
  // https://github.com/oxc-project/oxc-zed
  //
  // since we have oxlint and oxfmt in the monorepo
  // package.json, oxc-zed resolves the binaries
  // from node_modules

  // keep this here so zed doesn't fall back to
  // using it's built-in prettier
  "prettier": { "allowed": false },

  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          // leave null so nested `oxlint.config.mts` files are discovered
          "configPath": null,
          "disableNestedConfig": false,
          "run": "onType",
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "warn",
        },
      },
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          // leave null so nested `.oxfmtrc.json` files are discovered
          "fmt.configPath": null,
          "run": "onSave",
        },
      },
    },
  },

  "languages": {
    // `language_servers` REPLACES zed's default list rather than extending it,
    // so the default entries have to be repeated verbatim:
    //   ["!typescript-language-server", "vtsls", "..."]
    // `!eslint` is ours: this repo migrated to oxlint and has no eslint config,
    // so zed's bundled eslint server only ever emits `eslint/noLibrary` errors.
    // `"..."` still pulls in oxlint, oxfmt and tailwindcss-language-server
    "TypeScript": {
      "language_servers": [
        "!typescript-language-server",
        "!eslint",
        "vtsls",
        "oxlint",
        "...",
      ],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" },
      ],
    },
    "TSX": {
      "language_servers": [
        "!typescript-language-server",
        "!eslint",
        "vtsls",
        "oxlint",
        "...",
      ],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" },
      ],
    },
    "JavaScript": {
      "language_servers": [
        "!typescript-language-server",
        "!eslint",
        "vtsls",
        "oxlint",
        "...",
      ],
      "formatter": [
        { "language_server": { "name": "oxfmt" } },
        { "code_action": "source.fixAll.oxc" },
      ],
    },
    "JSON": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "JSONC": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "Markdown": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "YAML": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "TOML": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "HTML": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
    "CSS": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
  },

  "file_scan_exclusions": [
    // defaults
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",

    // also exclude:

    // node_modules
    "**/node_modules/**",

    "**/.env.example",

    // exclude contents of agent skills
    ".agents/skills/**/scripts/**",
    ".agents/skills/**/references/**",
    ".agents/skills/**/rules/**",

    // all files in `.claude` (symlinks to .agents)
    ".claude/**",
  ],
  "read_only_files": ["yarn.lock", "skills-lock.json"],
}
