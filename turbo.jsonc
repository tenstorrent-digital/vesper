{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    /**
     * no-op task — no package defines a `transit` script
     *
     * tasks that read a dependency's *source* but do not consume its build
     * *output* should depend on `transit` rather than `^<task>`: the hash still
     * threads through the package graph (so caches invalidate correctly when a
     * dependency changes) without forcing the tasks to run one after another
     *
     * see: https://turborepo.dev/docs/core-concepts/package-and-task-graph#transit-nodes
     */
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "NEXT_RUNTIME", "VERCEL_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "storybook/**"],
      "outputs": ["$TURBO_ROOT$/apps/website/public/storybook/**"]
    },
    "check-types": {
      // NOT a transit node: `docs` resolves `@tenstorrent/vesper` subpaths to
      // declaration files under `dist`, so this is a real build-output
      // dependency and `tsc` cannot run until vesper has been built
      "dependsOn": ["^build"]
    },
    "dev": {
      // ensure workspace deps are built (turbo restores `dist` from cache) so
      // we never boot against a missing or half-written `dist`
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "watch": {
      // depends on `build` because `dev` above pulls `^build` into the dev graph
      // (otherwise concurrent writes write over each other)
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["transit"],
      "passThroughEnv": ["AGENTS"]
    },
    "test:update": {
      "dependsOn": ["transit"],
      "passThroughEnv": ["AGENTS"]
    },
    "test:watch": {
      "persistent": true,
      "passThroughEnv": ["AGENTS"]
    },
    "generate:icons": {
      "inputs": [
        "$TURBO_ROOT$/packages/vesper/assets/icons/**",
        "$TURBO_ROOT$/packages/vesper/scripts/generate-icons.ts"
      ],
      "outputs": ["$TURBO_ROOT$/packages/vesper/src/components/icons/**"]
    },

    "quality": {
      // note: we pass `--continue` to the `quality` script in `package.json` so
      // turbo doesn't cancel in-flight task as soon as one fails - this way a
      // failure in one task (e.g. format) doesn't hide the results of the other tasks
      "dependsOn": ["//#lint:root", "lint", "//#format", "check-types"]
    },
    "quality:fix": {
      // similar to above, `quality:fix` uses `--continue=always` so that formatting
      // is still applied if `oxlint --fix` exits non-zero because some problems
      // were not auto-fixable
      "dependsOn": ["//#lint:fix:root", "lint:fix", "//#format:fix"],
      "cache": false
    },

    // oxlint and oxfmt are fast enough to cover the whole monorepo in a single
    // pass, so they are registered as root tasks instead of per-package ones
    // see: https://turborepo.dev/docs/guides/tools/oxc
    //
    // a root task hashes every file in the repo - including the shared configs
    // in `packages/oxlint-config` and the `.oxfmtrc.json`/`oxlint.config.mts`
    // files each app owns - so these tasks don't need `transit` since nothing
    // is scoped to a single package
    //
    // the exception is linting apps: type-aware lint rules read the types of the
    // workspace packages an app depends on (eg. `@tenstorrent/vesper`) from their
    // build output, so each app has its own `lint` task that runs after `^build`,
    // and the root lint (`lint:root`) skips `apps/**`
    // see: https://turborepo.dev/docs/guides/tools/oxc (type-aware linting)
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#lint:root": {
      // `apps/**` is linted by each app's own `lint` task
      "inputs": ["$TURBO_DEFAULT$", "!apps/**"]
    },
    "//#lint:fix:root": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      // formatting runs after lint fixes so the two tools never write to the
      // same file at once
      "dependsOn": ["//#lint:fix:root", "website#lint:fix"],
      "cache": false
    },
    "clean": {
      // clean caches, generated, and dist folders across the repo
      //
      // apps and packages in the monorepo have their own `clean` tasks,
      // and each has different folders that need to be cleaned - see each
      // app's package.json `clean` script for specific folders that are cleaned
      "cache": false
    },
    "//#clean-caches": {
      // clean turbo cache folders across the monorepo
      "cache": false
    },
  }
}
