{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "storybook/**"],
      "outputs": ["../../apps/docs/public/storybook/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {},
    "watch": {},
    "test": {},
    "dev:vesper": {
      "with": ["@repo/vesper#dev"],
      "cache": false,
      "persistent": true
    },
    "dev:docs": {
      "with": ["docs#dev", "@repo/vesper#dev", "@repo/vesper#watch"],
      "cache": false,
      "persistent": true
    },
    "generate:icons": {
      "inputs": [
        "$TURBO_ROOT$/packages/vesper/assets/icons/**",
        "$TURBO_ROOT$/packages/vesper/scripts/generate-icons.ts"
      ],
      "outputs": ["$TURBO_ROOT$/packages/vesper/src/components/Icon/**"]
    }
  }
}
