{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    /**
     * no-op task — no package defines a `transit` script
     *
     * tasks that read a dependency's *source* but do not consume its build
     * *output* should depend on `transit` rather than `^<task>`: the hash still
     * threads through the package graph (so caches invalidate correctly when a
     * dependency changes) without forcing the tasks to run one after another
     *
     * see: https://turborepo.dev/docs/core-concepts/package-and-task-graph#transit-nodes
     */
    "transit": {
      "dependsOn": ["^transit"],
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "NEXT_RUNTIME", "VERCEL_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "storybook/**"],
      "outputs": ["$TURBO_ROOT$/apps/website/public/storybook/**"],
    },
    "check-types": {
      // NOT a transit node: `docs` resolves `@tenstorrent/vesper` subpaths to
      // declaration files under `dist`, so this is a real build-output
      // dependency and `tsc` cannot run until vesper has been built
      "dependsOn": ["^build"],
    },
    "dev": {
      // ensure workspace deps are built (turbo restores `dist` from cache) so
      // we never boot against a missing or half-written `dist`
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
    },
    "watch": {
      // depends on `build` because `dev` above pulls `^build` into the dev graph
      // (otherwise concurrent writes write over each other)
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
    },
    "clean": {
      "cache": false,
    },
    "test": {
      "dependsOn": ["transit"],
    },
    "test:update": {
      "dependsOn": ["transit"],
    },
    "test:watch": {
      "persistent": true,
    },
    "generate:icons": {
      "inputs": [
        "$TURBO_ROOT$/packages/vesper/assets/icons/**",
        "$TURBO_ROOT$/packages/vesper/scripts/generate-icons.ts",
      ],
      "outputs": ["$TURBO_ROOT$/packages/vesper/src/components/Icon/**"],
    },

    // oxlint and oxfmt are fast enough to cover the whole monorepo in a single
    // pass, so they are registered as root tasks instead of per-package ones
    // see: https://turborepo.dev/docs/guides/tools/oxc
    //
    // a root task hashes every file in the repo - including the shared configs
    // in `packages/oxlint-config` and the `.oxfmtrc.json`/`oxlint.config.mts`
    // files each app owns - so neither task needs extra `inputs` to be cached
    // correctly, and neither needs `transit` since nothing is scoped to a
    // single package
    "//#lint": {},
    // TODO: lint depends on generate:demos from inside website (this will need a re-think)
    "//#lint:fix": {
      "cache": false,
    },
    "//#format": {},
    "//#format:fix": {
      // formatting runs after lint fixes so the two tools never write to the
      // same file at once
      "dependsOn": ["//#lint:fix"],
      "cache": false,
    },
  },
}
