{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    /**
     * no-op task — no package defines a `transit` script
     *
     * tasks that read a dependency's *source* but do not consume its build
     * *output* should depend on `transit` rather than `^<task>`: the hash still
     * threads through the package graph (so caches invalidate correctly when a
     * dependency changes) without forcing the tasks to run one after another
     *
     * see: https://turborepo.dev/docs/core-concepts/package-and-task-graph#transit-nodes
     */
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "NEXT_RUNTIME", "VERCEL_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "storybook/**"],
      "outputs": ["../../apps/docs/public/storybook/**"]
    },
    "check-types": {
      // NOT a transit node: `docs` resolves `@tenstorrent/vesper` subpaths to
      // declaration files under `dist`, so this is a real build-output
      // dependency and `tsc` cannot run until vesper has been built
      "dependsOn": ["^build"]
    },
    "dev": {
      // ensure workspace deps are built (turbo restores `dist` from cache) so
      // we never boot against a missing or half-written `dist`
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "watch": {
      // depends on `build` because `dev` above pulls `^build` into the dev graph
      // (otherwise concurrent writes write over each other)
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:update": {
      "dependsOn": ["transit"]
    },
    "test:watch": {
      "persistent": true
    },
    "generate:icons": {
      "inputs": [
        "$TURBO_ROOT$/packages/vesper/assets/icons/**",
        "$TURBO_ROOT$/packages/vesper/scripts/generate-icons.ts"
      ],
      "outputs": ["$TURBO_ROOT$/packages/vesper/src/components/Icon/**"]
    },
    "lint": {
      // eslint is not type-aware here (no `parserOptions.project`), so it
      // never needs a dependency's built output - only its hash
      "dependsOn": ["transit"]
    },
    "lint:fix": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "format": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "format:check": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "//#format:root": {
      // root task to allow running `format` from root
      // see: https://turborepo.dev/docs/crafting-your-repository/configuring-tasks#registering-root-tasks
      //
      // accepts optional file arguments (`yarn format <files>`), and formats
      // every file in the repository when no arguments are passed
      "cache": false
    },
    "//#format:check:root": {
      // root task to allow running `format:check` from root
      //
      // accepts optional file arguments (`yarn format:check <files>`), and
      // checks every file in the repository when no arguments are passed
      //
      // used by the pre-commit formatting hook (see `.hooks/pre-commit`)
      "cache": false
    }
  }
}
