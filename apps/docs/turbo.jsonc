{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@repo/vesper#build:storybook"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },

    "dev": {
      /**
       * running `build` here is required so `packages/vesper/src`
       * is built into `dist` so we can use them here
       */
      "dependsOn": ["^build"],
      /**
       * and then we also need:
       *
       * (1) `@repo/vesper#watch`
       *
       * recompiles `packages/vesper/src` into `dist`,
       * which is what the docs app actually imports
       *
       * (2) `@repo/vesper#dev`
       *
       * storybook on localhost:3000, proxied at `/storybook`
       * in dev by `apps/docs/src/proxy.ts`
       */
      "with": ["@repo/vesper#watch", "@repo/vesper#dev"],
      "cache": false,
      "persistent": true
    }
  }
}
