{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@tenstorrent/vesper#build:storybook"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/docs/**" // monorepo docs
      ],
      /**
       * `generated/**` holds the demo modules extracted from `docs/**` by
       * `src/lib/mdx/remark-tsx-demos.mts` while the mdx is compiled
       *
       * caching them with `.next` keeps a restored build complete, so tasks
       * that read them (eg. `check-types`) see the same files a fresh build
       * would have written
       */
      "outputs": [".next/**", "!.next/cache/**", "generated/**"]
    },

    "dev": {
      /**
       * running `build` here is required so `packages/vesper/src`
       * is built into `dist` so we can use them here
       */
      "dependsOn": ["^build"],
      /**
       * and then we also need:
       *
       * (1) `@tenstorrent/vesper#watch`
       *
       * recompiles `packages/vesper/src` into `dist`,
       * which is what the docs app actually imports
       *
       * (2) `@tenstorrent/vesper#dev`
       *
       * storybook on localhost:5173, proxied at `/storybook`
       * in dev by `apps/website/src/proxy.ts`
       */
      "with": ["@tenstorrent/vesper#watch", "@tenstorrent/vesper#dev"],
      "cache": false,
      "persistent": true
    }
  }
}
