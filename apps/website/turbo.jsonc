{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    /**
     * writes `generated/**`: the demo modules extracted from the `tsx demo`
     * code blocks in `docs/**`
     *
     * every task that compiles or type checks a document depends on it,
     * because the modules `src/lib/mdx/remark-tsx-demos.mts` imports into a
     * document have to exist before next (or `tsc`) reads it
     */
    "generate:demos": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**" // monorepo docs
      ],
      /**
       * deliberately uncached: the task also *deletes* the demos of code blocks
       * that are gone, and turbo only extracts cached outputs on a cache hit
       */
      "cache": false
    },

    "build": {
      "dependsOn": [
        "^build",
        "generate:demos",
        "@tenstorrent/vesper#build:storybook"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/docs/**" // monorepo docs
      ],
      // `.next/dev` is written by `next dev`, not `next build`
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],

      // vercel system variables read at build time (see `src/lib/constants.ts`)
      //
      // (`NEXT_PUBLIC_*` is added automatically by turbo w next)
      "env": [
        "VERCEL_ENV",
        "VERCEL_BRANCH_URL",
        "VERCEL_URL",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ],

      // keep the rest of vercel's system variables available to `next build`
      // (eg. `VERCEL_GIT_COMMIT_SHA`) so they can use them on their end during
      // builds without adding them to the task hash
      "passThroughEnv": ["VERCEL_*"]
    },

    // `tsc` compiles `generated/**` along with the rest of the app
    //
    // note: `lint` doesn't depend on `generate:demos` like this does, because
    // `generated/**` is gitignored and oxlint always skips gitignored files
    // (even with `--no-ignore`)
    "check-types": {
      "dependsOn": ["^build", "generate:demos"]
    },

    "dev": {
      /**
       * running `build` here is required so `packages/vesper/src`
       * is built into `dist` so we can use them here
       */
      "dependsOn": ["^build", "generate:demos"],
      /**
       * and then we also need:
       *
       * (1) `@tenstorrent/vesper#watch`
       *
       * recompiles `packages/vesper/src` into `dist`,
       * which is what the docs app actually imports
       *
       * (2) `@tenstorrent/vesper#dev`
       *
       * storybook on localhost:5173, proxied at `/storybook`
       * in dev by `apps/website/src/proxy.ts`
       */
      "with": ["@tenstorrent/vesper#watch", "@tenstorrent/vesper#dev"],
      "cache": false,
      "persistent": true
    }
  }
}
