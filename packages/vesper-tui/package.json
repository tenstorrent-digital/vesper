{
  "name": "vesper-tui",
  "version": "0.1.0",
  "description": "Build React and Vesper applications for the terminal",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vesper-tui": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "test": "tsx --test src/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "esbuild": "0.28.2",
    "react-reconciler": "0.33.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-reconciler": "0.33.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.22.3",
    "typescript": "5.9.2"
  }
}
