{
  "name": "@repo/vesper",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./tooltip": {
      "types": "./dist/components/tooltip/tooltip.d.ts",
      "import": "./dist/components/tooltip/tooltip.js"
    },
    "./theme-switcher": {
      "types": "./dist/components/theme-switcher/theme-switcher.d.ts",
      "import": "./dist/components/theme-switcher/theme-switcher.js"
    },
    "./admonition": {
      "types": "./dist/components/admonition/admonition.d.ts",
      "import": "./dist/components/admonition/admonition.js"
    },
    "./badge": {
      "types": "./dist/components/badge/badge.d.ts",
      "import": "./dist/components/badge/badge.js"
    },
    "./accordion": {
      "types": "./dist/components/accordion/accordion.d.ts",
      "import": "./dist/components/accordion/accordion.js"
    },
    "./avatar-group": {
      "types": "./dist/components/avatar-group/avatar-group.d.ts",
      "import": "./dist/components/avatar-group/avatar-group.js"
    },
    "./avatar": {
      "types": "./dist/components/avatar/avatar.d.ts",
      "import": "./dist/components/avatar/avatar.js"
    },
    "./progress-bar": {
      "types": "./dist/components/progress-bar/progress-bar.d.ts",
      "import": "./dist/components/progress-bar/progress-bar.js"
    },
    "./split-button": {
      "types": "./dist/components/split-button/split-button.d.ts",
      "import": "./dist/components/split-button/split-button.js"
    },
    "./text-button": {
      "types": "./dist/components/text-button/text-button.d.ts",
      "import": "./dist/components/text-button/text-button.js"
    },
    "./icon-button": {
      "types": "./dist/components/icon-button/icon-button.d.ts",
      "import": "./dist/components/icon-button/icon-button.js"
    },
    "./button": {
      "types": "./dist/components/button/button.d.ts",
      "import": "./dist/components/button/button.js"
    },
    "./menu": {
      "types": "./dist/components/menu/menu.d.ts",
      "import": "./dist/components/menu/menu.js"
    },
    "./typography": {
      "types": "./dist/components/typography/typography.d.ts",
      "import": "./dist/components/typography/typography.js"
    },
    "./icons": {
      "types": "./dist/components/icons/icons.d.ts",
      "import": "./dist/components/icons/icons.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./styles.css": "./dist/styles/styles.css",
    "./tailwind.css": "./dist/styles/tailwind.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:alias": "tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "build:css": "tsx scripts/copy-css.ts",
    "build": "rm -rf dist && yarn build:tsc && yarn build:alias && yarn build:css",
    "prebuild": "yarn lint",
    "watch:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "watch:alias": "tsc-alias -p tsconfig.build.json -w --resolve-full-paths --resolve-full-extension .js",
    "watch:css": "tsx scripts/watch-css.ts",
    "watch": "concurrently --kill-others-on-fail --names tsc,alias,css --prefix-colors auto \"yarn watch:tsc\" \"yarn watch:alias\" \"yarn watch:css\"",
    "dev": "storybook dev -p 3000 -c storybook",
    "lint": "eslint . --max-warnings 0",
    "scaffold:component": "turbo gen vesper-component",
    "generate:icons": "tsx scripts/generate-icons.ts && eslint src/components/icons/*.{ts,tsx} --fix && prettier --write src/components/icons/*.{ts,tsx}",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "build:storybook": "storybook build -c storybook -o ../../apps/docs/src/public/storybook"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@storybook/addon-a11y": "^10.4.3",
    "@storybook/react-vite": "^10.4.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.8",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "playwright": "^1.60.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "storybook": "^10.4.3",
    "svgo": "^4.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.3",
    "typescript": "5.9.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.8",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.10"
  }
}
