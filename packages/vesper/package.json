  ],
  "scripts": {
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:alias": "tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "build:css": "tsx scripts/copy-css.ts",
    "build": "rm -rf dist && yarn build:tsc && yarn build:alias && yarn build:css",
    "prebuild": "yarn lint",
    "watch:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "watch:alias": "tsc-alias -p tsconfig.build.json -w --resolve-full-paths --resolve-full-extension .js",
    "watch:css": "tsx scripts/watch-css.ts",
    "watch": "concurrently --kill-others-on-fail --names tsc,alias,css --prefix-colors auto \"yarn watch:tsc\" \"yarn watch:alias\" \"yarn watch:css\"",
    "dev": "storybook dev -p 3000 -c storybook",
    "build:storybook": "storybook build -c storybook -o ../../apps/docs/public/storybook",
    "lint": "eslint . --max-warnings 0",
    "scaffold:component": "turbo gen vesper-component",
    "generate:icons": "tsx scripts/generate-icons.ts && eslint src/components/icons/*.{ts,tsx} --fix && prettier --write src/components/icons/*.{ts,tsx}",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
