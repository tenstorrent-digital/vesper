{
  "name": "@repo/vesper",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./styles.css": "./src/styles/index.css",
    "./tokens": "./src/tokens/index.ts",
    "./Icon": "./src/components/Icon/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "generate:icons": "tsx scripts/generate-icons.ts && eslint src/components/Icon/*.{ts,tsx} --fix && prettier --write src/components/Icon/*.{ts,tsx}",
    "generate:colors": "tsx scripts/generate-colors.ts && prettier --write src/styles/colors.css src/tokens/colors.ts",
    "generate:spacing": "tsx scripts/generate-spacing.ts && prettier --write src/styles/spacing.css src/tokens/spacing.ts",
    "generate:tracking": "tsx scripts/generate-tracking.ts && prettier --write src/styles/tracking.css src/tokens/tracking.ts",
    "generate:leading": "tsx scripts/generate-leading.ts && prettier --write src/styles/leading.css src/tokens/leading.ts",
    "generate:radius": "tsx scripts/generate-radius.ts && prettier --write src/styles/radius.css src/tokens/radius.ts",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "svgo": "^4.0.1",
    "tsx": "^4.22.3",
    "typescript": "5.9.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
