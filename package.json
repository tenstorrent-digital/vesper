{
  "name": "vesper",
  "private": true,
  "description": "Monorepo for the Vesper design system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:vesper": "turbo run build --filter=@tenstorrent/vesper",
    "build:website": "turbo run build --filter=website",
    "dev": "turbo run dev",
    "dev:vesper": "turbo run dev --filter=@tenstorrent/vesper",
    "dev:website": "turbo run dev --filter=website",
    "build:storybook": "turbo run build:storybook --filter=@tenstorrent/vesper",
    "test": "turbo run test --",
    "test:vesper": "turbo run test --filter=@tenstorrent/vesper --",
    "test:vesper:update": "turbo run test:update --filter=@tenstorrent/vesper --",
    "test:watch:vesper": "turbo run test:watch --filter=@tenstorrent/vesper --",
    "quality": "turbo run quality --continue --",
    "quality:ci": "turbo run quality --continue --log-prefix=none --",
    "quality:agent": "turbo run quality --continue --log-order=grouped --output-logs=errors-only --",
    "quality:fix": "turbo run quality:fix --continue=always --",
    "lint": "turbo run lint lint:root --continue --",
    "lint:fix": "turbo run lint:fix lint:root:fix --continue=always --",
    "lint:root": "oxlint --ignore-pattern 'apps/**' .",
    "lint:root:fix": "oxlint --fix --ignore-pattern 'apps/**' .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "check-types": "turbo run check-types --",
    "vale": "turbo run vale:check --",
    "vale:check": "vale sync && sh -c 'IFS=,; vale --no-global --glob=\"{${*:-*}}\" .' --",
    "vale:diff": "vale sync && { git diff -z --name-only --diff-filter=d --merge-base main; git ls-files -z --others --exclude-standard; } | xargs -0 -r vale --no-global",
    "generate:icons": "turbo run generate:icons --filter=@tenstorrent/vesper && oxlint packages/vesper/src/components/icons/*.{ts,tsx} --fix && oxfmt packages/vesper/src/components/icons/*.{ts,tsx}",
    "generate:tailwind": "turbo run generate:tailwind --filter=@tenstorrent/vesper && oxlint packages/vesper/src/styles/tailwind.css packages/vesper/src/utils/tailwind-{merge,merge.test}.ts --fix && oxfmt packages/vesper/src/styles/tailwind.css packages/vesper/src/utils/tailwind-{merge,merge.test}.ts",
    "generate:demos": "turbo run generate:demos --filter=website",
    "scaffold:component": "yarn workspace @tenstorrent/vesper scaffold:component",
    "scaffold:documentation": "turbo gen vesper-component-documentation",
    "agent:skills:add": "DISABLE_TELEMETRY=true npx skills add --yes --agent pi claude-code codex --",
    "agent:skills:remove": "DISABLE_TELEMETRY=true npx skills remove --yes --agent '*'",
    "agent:skills:update": "DISABLE_TELEMETRY=true npx skills update --yes --project",
    "clean": "turbo run clean && turbo run clean-caches",
    "clean-caches": "npx --yes rimraf --glob .turbo '{apps,packages}/*/.turbo'",
    "clean-install": "npx --yes rimraf --glob node_modules '{apps,packages}/*/node_modules' && rm -f yarn.lock && yarn cache clean && yarn",
    "changeset:publish": "yarn build:vesper && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@repo/oxlint-config": "*",
    "@repo/typescript-config": "*",
    "@turbo/gen": "^2.9.14",
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vvago/vale": "^3.22.0",
    "inquirer": "^9.3.7",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=24.13.1"
  },
  "packageManager": "yarn@1.22.22"
}
