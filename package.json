{
  "name": "vesper",
  "description": "Monorepo for the Vesper design system",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:vesper": "turbo run build --filter=@tenstorrent/vesper",
    "build:website": "turbo run build --filter=website",
    "dev": "turbo run dev",
    "dev:vesper": "turbo run dev --filter=@tenstorrent/vesper",
    "dev:website": "turbo run dev --filter=website",
    "build:storybook": "turbo run build:storybook --filter=@tenstorrent/vesper",
    "test:vesper": "turbo run test --filter=@tenstorrent/vesper --",
    "test:vesper:update": "turbo run test:update --filter=@tenstorrent/vesper --",
    "test:watch:vesper": "turbo run test:watch --filter=@tenstorrent/vesper --",
    "quality": "turbo run quality --continue --",
    "quality:agent": "turbo run quality --continue --log-order=grouped --output-logs=errors-only --",
    "quality:fix": "turbo run quality:fix --continue=always --",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "check-types": "turbo run check-types --",
    "generate:icons": "turbo run generate:icons --filter=@tenstorrent/vesper",
    "generate:demos": "turbo run generate:demos --filter=website",
    "scaffold:component": "yarn workspace @tenstorrent/vesper scaffold:component",
    "scaffold:documentation": "turbo gen vesper-component-documentation",
    "agent:skills:add": "DISABLE_TELEMETRY=true npx skills add --yes --agent pi claude-code codex --",
    "agent:skills:remove": "DISABLE_TELEMETRY=true npx skills remove --yes --agent '*'",
    "agent:skills:update": "DISABLE_TELEMETRY=true npx skills update --yes --project",
    "clean": "turbo run clean && rimraf --glob .turbo '{apps,packages}/*/.turbo'",
    "clean-install": "yarn workspaces run rimraf node_modules && yarn rimraf node_modules && rm -f yarn.lock && yarn cache clean && yarn",
    "changeset:publish": "yarn build:vesper && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@repo/typescript-config": "*",
    "@turbo/gen": "^2.9.14",
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "inquirer": "^9.3.7",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "oxfmt": "^0.67.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=24.13.1"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
