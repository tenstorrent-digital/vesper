{
  "name": "vesper",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:vesper": "turbo run build --filter=@repo/vesper",
    "dev": "turbo run dev watch",
    "dev:vesper": "turbo run dev:vesper",
    "dev:docs": "turbo run dev:docs",
    "build:storybook": "turbo run build:storybook --filter=@repo/vesper",
    "test:vesper": "turbo run test --filter=@repo/vesper",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "generate:icons": "turbo run generate:icons --filter=@repo/vesper",
    "scaffold:component": "yarn workspace @repo/vesper scaffold:component",
    "agent:skills:add": "DISABLE_TELEMETRY=true npx skills add --yes --agent pi claude-code codex --",
    "agent:skills:remove": "DISABLE_TELEMETRY=true npx skills remove --yes --agent '*'",
    "agent:skills:update": "DISABLE_TELEMETRY=true npx skills update --yes --project"
  },
  "devDependencies": {
    "@turbo/gen": "^2.9.14",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
