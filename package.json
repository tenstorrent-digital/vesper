{
  "name": "vesper",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "generate:colors": "turbo run generate:colors --filter=@repo/vesper",
    "generate:spacing": "turbo run generate:spacing --filter=@repo/vesper",
    "generate:radius": "turbo run generate:radius --filter=@repo/vesper",
    "generate:tracking": "turbo run generate:tracking --filter=@repo/vesper",
    "generate:leading": "turbo run generate:leading --filter=@repo/vesper",
    "generate:icons": "turbo run generate:icons --filter=@repo/vesper",
    "generate:tailwind": "turbo run generate:tailwind --filter=@repo/vesper",
    "generate:tokens": "turbo run generate:tokens --filter=!@repo/vesper",
    "generate:all": "turbo run generate:all --filter=!@repo/vesper",
    "scaffold:component": "yarn workspace @repo/vesper scaffold:component"
  },
  "devDependencies": {
    "@turbo/gen": "^2.9.14",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
