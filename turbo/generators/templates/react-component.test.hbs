import { render, cleanup } from "@testing-library/react";
import { beforeEach, afterEach, describe, expect, it } from "vitest";
import axe from "axe-core";
import { {{ name }} } from "@/components/{{ kebabCase name }}/{{ kebabCase name }}";

import "@/styles/styles.css";

afterEach(cleanup);

describe("{{ kebabCase name }} [unit]", () => {
  {{#if element}}
  it("renders a {{ element }}", () => {
    const { container } = render(<{{ name }} />);
    expect(container.firstElementChild?.tagName).toBe("{{ upperCase element }}");
  });
  {{else}}
  it("renders null", () => {
    const { container } = render(<{{ name }} />);
    expect(container.firstChild).toBeNull();
  });
  {{/if}}
});

describe("{{ kebabCase name }} [snapshot]", () => {
  it("renders correctly", async () => {
    const result = render(<{{ name }} />);

    expect(result.container.firstChild).toMatchSnapshot();
  });
});

describe("{{ kebabCase name }} [a11y]", () => {
  ["light", "dark"].forEach((theme) => {
    beforeEach(() => {
      document.documentElement.setAttribute("data-vesper-theme", theme);
    });

    afterEach(() => {
      document.documentElement.removeAttribute("data-vesper-theme");
    });

    it(`wcag2aaa (${theme})`, async () => {
      const result = render(<{{ name }} />);

      expect(
        await axe.run(result.container, { runOnly: "wcag2aaa" }),
      ).toHaveNoViolations();
    });
  });
});
