{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:colors": {
      "inputs": [
        "$TURBO_ROOT$/packages/tokens/assets/Dark.tokens.json",
        "$TURBO_ROOT$/packages/tokens/assets/Light.tokens.json",
        "$TURBO_ROOT$/packages/tokens/scripts/generate-colors.ts",
        "$TURBO_ROOT$/packages/tokens/scripts/utils.ts"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/tokens/src/colors.ts",
        "$TURBO_ROOT$/packages/tokens/src/colors.css"
      ]
    },
    "generate:spacing": {
      "inputs": [
        "$TURBO_ROOT$/packages/tokens/assets/Spacing.tokens.json",
        "$TURBO_ROOT$/packages/tokens/scripts/generate-spacing.ts",
        "$TURBO_ROOT$/packages/tokens/scripts/utils.ts"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/tokens/src/spacing.ts",
        "$TURBO_ROOT$/packages/tokens/src/spacing.css"
      ]
    },
    "generate:radius": {
      "inputs": [
        "$TURBO_ROOT$/packages/tokens/assets/Radius.tokens.json",
        "$TURBO_ROOT$/packages/tokens/scripts/generate-radius.ts",
        "$TURBO_ROOT$/packages/tokens/scripts/utils.ts"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/tokens/src/radius.ts",
        "$TURBO_ROOT$/packages/tokens/src/radius.css"
      ]
    },
    "generate:tracking": {
      "inputs": [
        "$TURBO_ROOT$/packages/tokens/assets/Tracking.tokens.json",
        "$TURBO_ROOT$/packages/tokens/scripts/generate-tracking.ts",
        "$TURBO_ROOT$/packages/tokens/scripts/utils.ts"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/tokens/src/tracking.ts",
        "$TURBO_ROOT$/packages/tokens/src/tracking.css"
      ]
    },
    "generate:leading": {
      "inputs": [
        "$TURBO_ROOT$/packages/tokens/assets/Leading.tokens.json",
        "$TURBO_ROOT$/packages/tokens/scripts/generate-leading.ts",
        "$TURBO_ROOT$/packages/tokens/scripts/utils.ts"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/tokens/src/leading.ts",
        "$TURBO_ROOT$/packages/tokens/src/leading.css"
      ]
    },
    "generate:tokens": {
      "dependsOn": [
        "generate:colors",
        "generate:leading",
        "generate:tracking",
        "generate:radius",
        "generate:spacing"
      ]
    },
    "generate:icons": {
      "inputs": [
        "$TURBO_ROOT$/packages/react/assets/Icon/**",
        "$TURBO_ROOT$/packages/react/scripts/generate-icons.ts"
      ],
      "outputs": ["$TURBO_ROOT$/packages/react/src/Icon/**"]
    }
  }
}
