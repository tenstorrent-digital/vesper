{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:colors": {
      "inputs": [
        "$TURBO_ROOT$/packages/tokens/assets/colors/**",
        "$TURBO_ROOT$/packages/tokens/scripts/generate-colors.ts"
      ],
      "outputs": ["$TURBO_ROOT$/packages/tokens/src/colors.ts"]
    }
  }
}
